# Copy this file to backend/.env and fill it in. .env is git-ignored; never commit it.
# `python -m flask --app app run` loads it automatically (python-dotenv).

# Key used to hash verification codes. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random key is used and codes stop working after a restart.
VERIFICATION_SECRET=

# Comma-separated list of email domains allowed to sign up.
ALLOWED_EMAIL_DOMAINS=psu.edu

# Where verification records live: "memory" (default, lost on restart) or "postgres"
# (uses the connection in db.py and creates the email_verifications table if needed).
VERIFICATION_STORE=memory

# How emails are sent: "console" (default, printed in the server terminal) or "smtp".
EMAIL_BACKEND=console
EMAIL_FROM=LionLift <no-reply@lionlift.local>

# --- SMTP settings, used only when EMAIL_BACKEND=smtp ---
# Gmail (see backend/docs/email-service.md): use a project Gmail account with
# 2-Step Verification on, create an App Password, and set EMAIL_FROM to that Gmail address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# starttls (587), ssl (465), or none (local test servers only)
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
